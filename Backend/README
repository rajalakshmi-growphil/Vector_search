# Steps to run this Project 

python -m venv venv
venv\Scripts\activate        # (Windows)
pip install -r requirements.txt

# create a MySQL Database

CREATE DATABASE medingen_db;

# Create .env file 

DATABASE_URL=mysql+mysqlconnector://root:YOUR_PASSWORD@localhost/medingen_db
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600


# Run the Server

python app.py